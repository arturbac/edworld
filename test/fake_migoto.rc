// the version resource 3Dmigoto's builds carry (XXMI's: "XXMI DLL (3Dmigoto)"), which edworld tells it by
// numbers instead of winver.h (not on the cross build's resource path): 1 = VS_VERSION_INFO, 0x40004 = VOS_NT_WINDOWS32, 2 = VFT_DLL
1 VERSIONINFO
FILEVERSION 1, 2, 3, 1
PRODUCTVERSION 1, 2, 3, 1
FILEOS 0x40004
FILETYPE 2
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "XXMI DLL (3Dmigoto) - d3d11.dll, edworld's test"
      VALUE "FileVersion", "1.2.3.1"
      VALUE "ProductName", "XXMI DLL (3Dmigoto)"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
