{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 29, "patch": 0 },
  "configurePresets": [
    {
      "name": "cfg-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/edplugin_common/cmake/clang-cl-msvc-sdk.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "cfg-ide",
      "hidden": true,
      "inherits": [ "cfg-base" ],
      "toolchainFile": "${sourceDir}/edplugin_common/cmake/clang-msvc-sdk.cmake"
    },
    {
      "name": "kdev-edworld-debug",
      "displayName": "Debug (clang, for the IDE's code model), build directory chosen by the IDE",
      "inherits": [ "cfg-ide" ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "kdev-edworld-release",
      "displayName": "Release (clang, for the IDE's code model), build directory chosen by the IDE",
      "inherits": [ "cfg-ide" ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "edworld-debug",
      "displayName": "Debug (clang-cl) in build/edworld-debug",
      "inherits": [ "cfg-base" ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "edworld-release",
      "displayName": "Release (clang-cl) in build/edworld-release",
      "inherits": [ "cfg-base" ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "binaryDir": "${sourceDir}/build/${presetName}"
    }
  ],
  "buildPresets": [
    { "name": "edworld-debug", "configurePreset": "edworld-debug" },
    { "name": "edworld-release", "configurePreset": "edworld-release" }
  ]
}
